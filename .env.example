# Connection string dari dashboard Neon (pakai yang "pooled", sslmode=require)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Kunci rahasia untuk menandatangani sesi admin. Buat dengan: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# Hanya dipakai oleh `npm run db:setup` untuk membuat akun admin pertama
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ganti-password-kuat"

# Zona waktu tampilan jadwal: Asia/Jakarta (WIB), Asia/Makassar (WITA), Asia/Jayapura (WIT)
NEXT_PUBLIC_TIMEZONE="Asia/Jakarta"
